{
  "name": "@examplecorp/identity-provider",
  "version": "1.0.0",
  "description": "Example Corp Identity Provider — central OIDC SSO + gateway for DMS, GMS, and future apps.",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts,js,json --exec tsx src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:prod": "node scripts/run-with-env.cjs production tsx src/db/migrate.ts",
    "db:migrate:mirror": "node scripts/run-with-env.cjs mirror tsx src/db/migrate.ts",
    "start:prod": "node scripts/run-with-env.cjs production node dist/main.js",
    "start:mirror": "node scripts/run-with-env.cjs mirror node dist/main.js",
    "start:prod:supervised": "node ../deploy/supervise.cjs --name sso-backend --env UV_THREADPOOL_SIZE=8 --env NODE_ENV=production --env-file .env.production --health http://{HOST}:{PORT}/health -- node dist/main.js",
    "start:mirror:supervised": "node ../deploy/supervise.cjs --name sso-backend --env UV_THREADPOOL_SIZE=8 --env NODE_ENV=mirror --env-file .env.mirror --health http://{HOST}:{PORT}/health -- node dist/main.js",
    "stop:supervised": "node ../deploy/supervise.cjs --stop sso-backend",
    "test:supervisor": "node test-scripts/supervise-live.mjs",
    "audit:gate": "node scripts/audit-gate.mjs",
    "db:seed:dev": "tsx src/db/seed-dev.ts",
    "db:seed:dev:prod": "node scripts/run-with-env.cjs production tsx src/db/seed-dev.ts",
    "db:seed:dev:mirror": "node scripts/run-with-env.cjs mirror tsx src/db/seed-dev.ts",
    "db:seed:users": "tsx src/db/seed-users.ts",
    "db:seed:qa-admin": "tsx scripts/seed-qa-admin.ts",
    "license:keygen": "tsx scripts/license-keygen.ts",
    "license:sign": "tsx scripts/license-sign.ts",
    "license:dev-issue": "tsx scripts/license-dev-issue.ts",
    "db:ack:dev-audit": "tsx scripts/ack-dev-audit-history.ts",
    "data:export-directory": "tsx scripts/export-directory.ts",
    "data:quality": "tsx scripts/report-identity-quality.ts",
    "audit:verify": "tsx src/db/verify-audit-chain.ts",
    "db:backup": "tsx scripts/db-backup.ts development",
    "db:backup:prod": "node scripts/run-with-env.cjs production tsx scripts/db-backup.ts production",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests --json --outputFile=test-results.json",
    "test:status": "node tools/generate-test-status.mjs",
    "env:verify:prod": "node scripts/run-with-env.cjs production tsx scripts/verify-prod-env.ts",
    "env:verify:mirror": "node scripts/run-with-env.cjs mirror tsx scripts/verify-prod-env.ts",
    "client:uris": "tsx scripts/update-client-redirect-uris.ts",
    "client:uris:mirror": "node scripts/run-with-env.cjs mirror tsx scripts/update-client-redirect-uris.ts",
    "client:uris:prod": "node scripts/run-with-env.cjs production tsx scripts/update-client-redirect-uris.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.6.1",
    "express": "^5.0.1",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "http-proxy-middleware": "^4.2.0",
    "ioredis": "^5.11.1",
    "jose": "^5.9.2",
    "ldapts": "^7.2.0",
    "oidc-provider": "^8.8.1",
    "pg": "^8.13.3",
    "pino": "^9.14.0",
    "pino-roll": "^4.0.0",
    "rate-limit-redis": "^4.3.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/oidc-provider": "^8.8.1",
    "@types/pg": "^8.11.6",
    "@types/swagger-ui-express": "^4.1.8",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "playwright": "^1.61.1",
    "ts-jest": "^29.4.12",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "qs": "^6.16.0"
  }
}
