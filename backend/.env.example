# ── Example Corp IdP configuration ────────────────────────────────────────────
NODE_ENV=development
PORT=7300
IDP_ISSUER=http://localhost:7301
IDP_INTERNAL_URL=http://localhost:7300

# IdP's OWN database (separate from every app — never shared).
# Must be defined here (or in .env.production) — if it's ever missing/blank/
# commented out, the app refuses to boot on a stray ambient DATABASE_URL
# rather than silently connecting to it. Set DATABASE_URL_TRUSTED=1 to opt out.
DATABASE_URL=postgres://postgres:change-me@localhost:5432/idp

# Admin console (/admin) — gated to members of this group.
IDP_ADMIN_GROUP=CN=EDAMS_Admins,OU=Groups,DC=examplecorp,DC=com

# Owner account pseudonym (owner-local notes, not in this repository). OPTIONAL but recommended: a long random
# value (e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"). With it set,
# a NEWLY SEEDED platform admin is stored under a keyed pseudonym (pa-<hash>@platform.invalid) instead
# of the owner's real email; the owner still signs in with the real email. Set once, NEVER change it
# (the account would stop being found), keep a copy in a password manager. Not needed by DMS.
PLATFORM_ADMIN_PEPPER=

# Password lockout (5 wrong passwords -> locked 15 minutes, plus a per-IP ceiling). OFF by owner decision
# 2026-10-09: people may retry as often as they like; every failure is still logged on the Sign-ins page.
# true brings the lock back. The authenticator-code lockout is separate and always on.
LOGIN_LOCKOUT_ENABLED=false

# DMS (EDAMS). On dev the bare loopback ports are reachable directly; on prod
# route everything (browser redirect + server-to-server) through the Apache
# /dms prefix on the public origin, except DMS_API_BASE_URL which the IdP
# server uses for its own admin-console internal calls (same machine → keep
# loopback to avoid a round-trip through Apache).
DMS_ENABLED=true
DMS_OIDC_AUTHORIZE_URL=http://localhost:7100/api/v1/auth/oidc/authorize
DMS_BACKCHANNEL_LOGOUT_URI=http://localhost:7100/api/v1/auth/backchannel-logout
DMS_API_BASE_URL=http://localhost:7100/api/v1
DMS_INTERNAL_API_KEY=replace-with-shared-internal-api-key-at-least-32-characters
DMS_DEFAULT_TENANT=examplecorp

# Session/interaction cookie signing keys (comma-separated; rotate by prepending).
COOKIE_KEYS=change-me-key-1,change-me-key-2

# Reverse-proxy hops to trust for X-Forwarded-For (Express "trust proxy"). Set to
# the number of proxies/load balancers actually in front of this service.
TRUST_PROXY_HOPS=1

# Encrypts totp_secret at rest (AES-256-GCM). Set a real random value in prod.
TOTP_ENCRYPTION_KEY=change-me

# HMAC-SHA256 key for the idp_admin_audit tamper-evident hash chain. Set a
# real random value in prod, distinct from every other secret above.
IDP_AUDIT_HMAC_SECRET=change-me

# Token lifetimes (seconds)
TTL_ACCESS_TOKEN=3600
TTL_ID_TOKEN=3600
TTL_REFRESH_TOKEN=86400
TTL_SESSION=1209600

# ── Active Directory / LDAP (AD-primary). Leave LDAP_URL empty to use local-only.
LDAP_URL=
LDAP_BIND_DN=CN=svc-idp,OU=Service,DC=examplecorp,DC=com
LDAP_BIND_PASSWORD=
LDAP_SEARCH_BASE=OU=Users,DC=examplecorp,DC=com
LDAP_USERNAME_ATTR=userPrincipalName

# ── Relying-party client secrets (seeded into idp_clients on first boot) ──────
EDAMS_CLIENT_SECRET=edams-dev-secret
EDAMS_REDIRECT_URIS=http://localhost:7101/auth/callback
GMS_CLIENT_SECRET=gms-dev-secret
GMS_REDIRECT_URIS=http://localhost:7301/bridge/gms/callback

# ── GMS token bridge (no GMS code changes) ────────────────────────────────────
GMS_BRIDGE_ENABLED=true
# Must equal GMS backend's SSO_INTERNAL_API_KEY. It authenticates only the
# narrow IdP-to-GMS bridge API; GMS retains its database and JWT secrets.
GMS_INTERNAL_API_KEY=replace-with-shared-internal-api-key-at-least-32-characters
GMS_FRONTEND_URL=http://localhost:7201
GMS_API_BASE=http://localhost:7200/api/v1
# Must equal GMS backend's SSO_ROLES_API_KEY. Opposite direction from
# GMS_INTERNAL_API_KEY above — gates GMS calling INTO SSO's per-user
# role-grant API (directive §6.3).
SSO_ROLES_API_KEY=replace-with-a-different-shared-secret-at-least-32-characters
PORTAL_CLIENT_SECRET=portal-dev-secret

# Post-logout redirect allowlists. Optional in dev (config.ts has loopback
# defaults) but required in .env.production, which reads no other file.
EDAMS_LOGOUT_URIS=http://localhost:7101/login
GMS_LOGOUT_URIS=http://localhost:7201/login

# -- Same-origin GMS gateway (a second Express app inside this process) --------
# gms.localtest.me resolves to 127.0.0.1 with no hosts-file edit. GMS's dev
# frontend force-routes its API to the backend port for literal `localhost`
# hosts, so a non-loopback hostname is what lets the bridged session work
# same-origin with no CORS and no GMS code change. Production refuses to boot
# if GATEWAY_URL is still this dev value.
GATEWAY_PORT=4200
# Requests per minute per address through the GMS gateway (default 6000).
# GATEWAY_RATE_LIMIT_PER_MINUTE=6000
GATEWAY_URL=http://gms.localtest.me:4200
GMS_FRONTEND_TARGET=http://localhost:7201
GMS_API_TARGET=http://localhost:7200
# The localStorage key GMS's own frontend reads its session from.
GMS_SESSION_KEY=gms-auth-session

# -- Optional ------------------------------------------------------------------
# Shared rate-limit store. Unset means per-process in-memory limiting, which is
# correct for a single instance; set it only when SSO runs more than one process.
# REDIS_URL=redis://127.0.0.1:6379/2
# pino level. debug re-enables the per-request logs main.ts quiets by default.
# LOG_LEVEL=info
# Swagger UI at /api-docs. On by default outside production.
# ENABLE_API_DOCS=true
# Opt out of the ambient-DATABASE_URL boot refusal. Almost never right.
# DATABASE_URL_TRUSTED=1
# Bind address. 127.0.0.1 by default — do not open this up without a reason.
# HOST=127.0.0.1

# -- Internal API and metrics --------------------------------------------------
# Source addresses allowed to reach the internal service-to-service API, checked
# BEFORE the shared key. "*" disables the check — never in production.
INTERNAL_API_ALLOWED_IPS=127.0.0.1,::1,::ffff:127.0.0.1
# /metrics reports MFA-enrolment and hourly login-FAILURE counts. Both endpoints
# require an admin session or this key as `x-metrics-key`.
ENABLE_PUBLIC_METRICS_ROUTE=false
METRICS_API_KEY=

# -- db:seed:dev overrides -----------------------------------------------------
# Defaults are admin@examplecorp.com / master@examplecorp.com with the dev
# password. seed-dev.ts refuses the dev password when NODE_ENV=production.
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
# SEED_MASTER_EMAIL=
# SEED_MASTER_PASSWORD=

# Admin console needs two-factor sign-in when true (default false). Turn on after every administrator has enrolled.
ADMIN_REQUIRE_MFA=false

# Platform licensing (docs/operations/PLATFORM-LICENSING.md). SSO's own licence is only enforced if the platform administrator has saved one
# for SSO under Admin > Licences; with none, this setting changes nothing. enforce (default) = read-only once the licence has expired and its
# grace period is over; warn = compute and show the state but never refuse anything; off = ignore licences entirely.
# Emergency switch: set LICENSE_ENFORCEMENT=warn and restart. Sign-in, OIDC, the portal and the licence page keep working even when expired.
LICENSE_ENFORCEMENT=enforce
# Per-application licensing (docs/operations/PLATFORM-LICENSING.md section 9). LICENSE_REQUIRED defaults to false in development; true means a system with no
# verified licence is unusable. Generate a development key pair with: npm run license:keygen -- --out <folder OUTSIDE the repo>
# LICENSE_REQUIRED=false
# Path to the dedicated licence-signing PEM (outside the repo). Unset: licences are signed with the OIDC key (development only).
# LICENSE_SIGNING_KEY_FILE=

# Tamper detection and incident response (SSO-OPERATIONS.md section 17).
# INCIDENT_LOCK_FILE: while this FILE exists every state-changing request answers 403 INCIDENT_READ_ONLY (sign-in, health, licence routes, the owner's verification and the key routes excepted).
#   Unset = no file lock (development). Only deploy/tamper/tamper.cjs clear removes the file.
# INCIDENT_RESPONSE: contain (record, alert, end the offender's sessions, lock) | alert (record and alert only) | off. Default: contain in production, alert elsewhere.
# OPS_WATCH_KEY_FILE: a file holding the shared key for the read-only chain-head endpoint the tamper watcher's daily anchor calls (unset = that endpoint answers 404).
# INCIDENT_LOCK_FILE=
# INCIDENT_RESPONSE=alert
# OPS_WATCH_KEY_FILE=
# ── Owner verification (Phase 4; docs/sso/SSO-OPERATIONS.md, "Owner verification") ───────────────────────────────────────────
# Owner-only operations (signing keys, licences, platform settings, application sign-in settings, who is an IdP administrator, audit acknowledgements)
# need a single-use owner authorisation: security questions + emailed code (or an offline recovery code) + phone authenticator. Default: true in production,
# the mirror and any non-local issuer; false in development. Required and not enrolled = those operations are REFUSED, never allowed.
# OWNER_VERIFICATION_REQUIRED=false
# Whether a NEW enrolment (owner:enroll / owner:recover) includes the phone authenticator. Default false (owner decision 2026-10-21) = two proofs only (questions + emailed code or one recovery code).
# Only decides what a new enrolment asks for; an existing enrolment is always verified by the factors recorded in its own sealed store, so this never weakens it.
# OWNER_AUTHENTICATOR_REQUIRED=false   (write true to add the phone authenticator)
# AES key file for the sealed owner store, OUTSIDE the repository. Created by: npm run owner:enroll. The owner mailbox address and every secret live only in that store.
# OWNER_STORE_KEY_FILE=
# Outgoing mail for the emailed code. Unset or changed after enrolment = the emailed code is unavailable and a recovery code replaces it (never fewer factors).
# After changing the relay run: npm run owner:change-email
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# ── Platform settings (2026-10-11) ───────────────────────────────────────────────────────────────────────────────────────────
# LOGIN_LOCKOUT_ENABLED, ADMIN_REQUIRE_MFA and the TTL_* values above are now only the DEFAULTS. The platform administrator can change
# them (and password rules, branding, retention) under Admin > Settings; a stored change wins and applies without a restart.
# Reset a setting there to go back to the value in this file.
#
# How many password checks (scrypt, ~128 MB each) may run at once, how many may wait, and how long one may wait before it is turned away
# with "busy, try again". Worst-case memory is concurrency x 128 MB. Defaults shown; leave them unless the System page shows turned-away
# sign-ins during normal use.
# PASSWORD_HASH_CONCURRENCY=3
# PASSWORD_HASH_QUEUE=60
# PASSWORD_HASH_WAIT_MS=8000
# "Forgot your password?" requests (no email: they go to the administrators under Admin > Users). How many one address may send in a quarter hour.
# Leave at the default in production; the browser test suite raises it in development.
# RESET_REQUEST_RATE_LIMIT=5

# ── Other applications that sign in through this IdP (all optional; the Example Corp production and mirror leave every one of these unset) ───────────────────
# MOS (Manufacturing Operations Suite, on Odoo). MOS_ENABLED=true registers the OIDC client "mos"; then all three of these are REQUIRED (no fallback, so a production
# IdP can never boot with a development secret or a localhost address): MOS_CLIENT_SECRET, MOS_REDIRECT_URIS, MOS_LOGOUT_URIS (comma-separated addresses).
# MOS_PORTAL_URL puts a MOS tile on the portal (the address that starts MOS's own sign-in); without it MOS has no tile.
# MOS_BACKCHANNEL_LOGOUT_URI (optional) is where SSO POSTs a signed logout token when a person signs out or is disabled, so MOS ends that person's sessions too (server to server).
# MOS_ENABLED=false
# MOS_CLIENT_SECRET=
# MOS_REDIRECT_URIS=
# MOS_LOGOUT_URIS=
# MOS_PORTAL_URL=
# MOS_BACKCHANNEL_LOGOUT_URI=
# Any other application, as JSON lists (oidc/product-clients.ts; a malformed list stops the start):
#   PRODUCT_CLIENTS_JSON=[{"client_id":"shop","client_secret":"<16+ characters>","redirect_uris":["https://shop.example.com/auth/callback"],"post_logout_redirect_uris":["https://shop.example.com/"],"name":"Shop","backchannel_logout_uri":"http://127.0.0.1:16101/api/v1/auth/backchannel-logout"}]
#   PRODUCT_APPS_JSON=[{"rp":"shop","label":"Shop","name":"Shop - orders","url":"https://shop.example.com/"}]   (one portal tile per client; rp = the client_id)
# PRODUCT_CLIENTS_JSON=
# PRODUCT_APPS_JSON=
