# ── Example Corp IdP configuration ────────────────────────────────────────────
NODE_ENV=development
PORT=7300
IDP_ISSUER=http://localhost:7301
IDP_INTERNAL_URL=http://localhost:7300

# IdP's OWN database (separate from every app — never shared).
# Must be defined here (or in .env.production) — if it's ever missing/blank/
# commented out, the app refuses to boot on a stray ambient DATABASE_URL
# rather than silently connecting to it. Set DATABASE_URL_TRUSTED=1 to opt out.
DATABASE_URL=postgres://postgres:change-me@localhost:5432/idp

# Admin console (/admin) — gated to members of this group.
IDP_ADMIN_GROUP=CN=EDAMS_Admins,OU=Groups,DC=examplecorp,DC=com

# DMS (EDAMS). On dev the bare loopback ports are reachable directly; on prod
# route everything (browser redirect + server-to-server) through the nginx
# /dms prefix on the public origin, except DMS_API_BASE_URL which the IdP
# server uses for its own admin-console internal calls (same machine → keep
# loopback to avoid a round-trip through the reverse proxy).
DMS_ENABLED=true
DMS_OIDC_AUTHORIZE_URL=http://localhost:7100/api/v1/auth/oidc/authorize
DMS_BACKCHANNEL_LOGOUT_URI=http://localhost:7100/api/v1/auth/backchannel-logout
DMS_API_BASE_URL=http://localhost:7100/api/v1
DMS_INTERNAL_API_KEY=replace-with-shared-internal-api-key-at-least-32-characters
DMS_DEFAULT_TENANT=examplecorp

# Session/interaction cookie signing keys (comma-separated; rotate by prepending).
COOKIE_KEYS=change-me-key-1,change-me-key-2

# Reverse-proxy hops to trust for X-Forwarded-For (Express "trust proxy"). Set to
# the number of proxies/load balancers actually in front of this service.
TRUST_PROXY_HOPS=1

# Encrypts totp_secret at rest (AES-256-GCM). Set a real random value in prod.
TOTP_ENCRYPTION_KEY=change-me

# HMAC-SHA256 key for the idp_admin_audit tamper-evident hash chain. Set a
# real random value in prod, distinct from every other secret above.
IDP_AUDIT_HMAC_SECRET=change-me

# Token lifetimes (seconds)
TTL_ACCESS_TOKEN=3600
TTL_ID_TOKEN=3600
TTL_REFRESH_TOKEN=86400
TTL_SESSION=1209600

# ── Active Directory / LDAP (AD-primary). Leave LDAP_URL empty to use local-only.
LDAP_URL=
LDAP_BIND_DN=CN=svc-idp,OU=Service,DC=examplecorp,DC=com
LDAP_BIND_PASSWORD=
LDAP_SEARCH_BASE=OU=Users,DC=examplecorp,DC=com
LDAP_USERNAME_ATTR=userPrincipalName

# ── Relying-party client secrets (seeded into idp_clients on first boot) ──────
EDAMS_CLIENT_SECRET=edams-dev-secret
EDAMS_REDIRECT_URIS=http://localhost:7101/auth/callback
GMS_CLIENT_SECRET=gms-dev-secret
GMS_REDIRECT_URIS=http://localhost:7301/bridge/gms/callback
MRS_CLIENT_SECRET=mrs-dev-secret
MRS_REDIRECT_URIS=http://localhost:7400/api/auth/sso/callback
MRS_LOGOUT_URIS=http://localhost:7401/login
# Where the portal's MRS tile sends the browser to start that exchange.
MRS_SSO_LOGIN_URL=http://localhost:7400/api/auth/sso/login

# ── GMS token bridge (no GMS code changes) ────────────────────────────────────
GMS_BRIDGE_ENABLED=true
# Must equal GMS backend's SSO_INTERNAL_API_KEY. It authenticates only the
# narrow IdP-to-GMS bridge API; GMS retains its database and JWT secrets.
GMS_INTERNAL_API_KEY=replace-with-shared-internal-api-key-at-least-32-characters
GMS_FRONTEND_URL=http://localhost:7201
GMS_API_BASE=http://localhost:7200/api/v1
# Must equal GMS backend's SSO_ROLES_API_KEY. Opposite direction from
# GMS_INTERNAL_API_KEY above — gates GMS calling INTO SSO's per-user
# role-grant API (directive §6.3).
SSO_ROLES_API_KEY=replace-with-a-different-shared-secret-at-least-32-characters
