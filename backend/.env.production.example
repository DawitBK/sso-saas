NODE_ENV=production
PORT=7300
IDP_ISSUER=https://portal.examplecorp.com/sso
IDP_INTERNAL_URL=http://127.0.0.1:7300
# Must be defined here — if it's ever missing/blank/commented out, the app
# refuses to boot on a stray ambient DATABASE_URL rather than silently
# connecting to it. Set DATABASE_URL_TRUSTED=1 to opt out.
DATABASE_URL=postgresql://postgres:change-me-prod-password@127.0.0.1:5432/idpprod
TRUST_PROXY_HOPS=1

# REDIS_URL: leave UNSET by default. SSO's rate limiters are Redis-capable
# but opt-in (on a RAM-constrained server, do not provision Redis for SSO
# preemptively). Unset means per-process in-memory rate limiting (correct for a
# single instance).
# Only set this (e.g. redis://127.0.0.1:6379/2 — GMS/other apps use DB 0,
# DMS uses DB 1) if SSO is ever actually scaled to more than one process.

# Generate unique random values; never use the development defaults in production.
COOKIE_KEYS=replace-with-random-key-1,replace-with-random-key-2
TOTP_ENCRYPTION_KEY=replace-with-random-totp-key
IDP_AUDIT_HMAC_SECRET=replace-with-random-audit-key

# Active Directory — DELIBERATELY LEFT OFF in this template:
# whether to wire SSO to a real AD server is a deployment decision, so the default
# plan is to seed and register accounts directly in SSO instead. With LDAP_URL
# empty, config.ts disables AD and uses the local Postgres user store; the
# AD-resync job and DMS's AD-group role mapping simply have nothing to do.
# Nothing is broken by this — do not treat the absence as a gap to close.
#
# The block is listed here, commented, for one reason: production reads THIS
# file and nothing else, so nothing can be inherited from `.env` any more. If AD
# is ever turned on, these five keys have to be written here explicitly, and the
# failure mode if they are forgotten is silent — SSO does not error, it just
# tells every domain user their password is wrong.
# LDAP_URL=ldap://ad.examplecorp.com:389
# LDAP_BIND_DN=CN=svc-idp,OU=ServiceAccounts,DC=examplecorp,DC=com
# LDAP_BIND_PASSWORD=
# LDAP_SEARCH_BASE=OU=Users,DC=examplecorp,DC=com
# LDAP_USERNAME_ATTR=userPrincipalName

# Who may reach /admin. Plain idp_user_groups membership — there is no separate
# permission system. Missing from this template before 2026-09-06: config.ts has
# a default, so an incomplete file was silently deciding an access-control
# question on its own. It happens to be the same DN db/seed-dev.ts grants, so
# the fallback was correct — state it anyway rather than rely on that.
IDP_ADMIN_GROUP=CN=EDAMS_Admins,OU=Groups,DC=examplecorp,DC=com

# Owner account pseudonym (owner-local notes, not in this repository). OPTIONAL but recommended: a long random
# value (e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"). With it set,
# a NEWLY SEEDED platform admin is stored under a keyed pseudonym (pa-<hash>@platform.invalid) instead
# of the owner's real email; the owner still signs in with the real email. Set once, NEVER change it
# (the account would stop being found), keep a copy in a password manager. Not needed by DMS.
PLATFORM_ADMIN_PEPPER=

# Password lockout (5 wrong passwords -> locked 15 minutes, plus a per-IP ceiling). OFF by owner decision
# 2026-10-09: people may retry as often as they like; every failure is still logged on the Sign-ins page.
# true brings the lock back. The authenticator-code lockout is separate and always on.
LOGIN_LOCKOUT_ENABLED=false

# Token lifetimes, seconds. Defaults shown; uncomment only to change them.
# TTL_ACCESS_TOKEN=3600
# TTL_ID_TOKEN=3600
# TTL_REFRESH_TOKEN=86400
# TTL_SESSION=1209600

# Swagger UI at /api-docs. Off in production unless this is exactly "true".
# ENABLE_API_DOCS=false

# DMS (EDAMS): OIDC authorize + logout are URLs returned to the end user's
# browser — MUST use the public https://portal.examplecorp.com/dms origin.
# DMS_API_BASE_URL is called from the IdP backend itself on the same server,
# so 127.0.0.1 direct avoids a pointless Apache round-trip.
DMS_ENABLED=true
DMS_OIDC_AUTHORIZE_URL=https://portal.examplecorp.com/dms/api/v1/auth/oidc/authorize
DMS_BACKCHANNEL_LOGOUT_URI=https://portal.examplecorp.com/dms/api/v1/auth/backchannel-logout
DMS_API_BASE_URL=http://127.0.0.1:7100/api/v1
DMS_INTERNAL_API_KEY=must-match-DMS_INTERNAL_API_KEY
DMS_DEFAULT_TENANT=examplecorp

EDAMS_CLIENT_SECRET=replace-with-DMS-OIDC-client-secret
EDAMS_REDIRECT_URIS=https://portal.examplecorp.com/dms/auth/callback
EDAMS_LOGOUT_URIS=https://portal.examplecorp.com/dms/login
GMS_CLIENT_SECRET=replace-with-GMS-client-secret
GMS_REDIRECT_URIS=https://portal.examplecorp.com/sso/bridge/gms/callback
GMS_LOGOUT_URIS=https://portal.examplecorp.com/gms/login
PORTAL_CLIENT_SECRET=replace-with-portal-client-secret

GMS_BRIDGE_ENABLED=true
GMS_INTERNAL_API_KEY=must-match-GMS-SSO_INTERNAL_API_KEY
GMS_FRONTEND_URL=https://portal.examplecorp.com/gms
GMS_API_BASE=https://portal.examplecorp.com/api/v1
SSO_ROLES_API_KEY=must-match-GMS-SSO_ROLES_API_KEY

# Same-origin gateway for the GMS SSO handoff (gateway/server.ts). Apache
# proxies ONLY the narrow /gms/__sso path here — GMS's own already-proven
# /gms and /api/v1 rules are untouched and keep serving everything else.
# GATEWAY_URL must NOT be left at the dev-only gms.localtest.me default —
# assertProdSafeDefaults() refuses to boot if it detects that in production.
GATEWAY_PORT=4200
GATEWAY_URL=https://portal.examplecorp.com/gms
GMS_FRONTEND_TARGET=http://127.0.0.1:7201
GMS_API_TARGET=http://127.0.0.1:7200

# P1-10: source addresses allowed to reach this system's INTERNAL service-to-service
# API, checked BEFORE the shared key is compared. Every real caller is another
# Example Corp backend on this same host, so loopback-only matches the actual
# topology and removes remote brute-forcing of the static key entirely.
# Comma-separated. "*" disables the check -- never in production.
INTERNAL_API_ALLOWED_IPS=127.0.0.1,::1,::ffff:127.0.0.1

# P1-20: /metrics and /api/v1/metrics report MFA-enrolment counts and hourly
# login-FAILURE counts -- together they tell an attacker how large the un-MFA'd
# population is and whether their own attempts are landing. Both endpoints now
# require an admin portal session, or this key presented as `x-metrics-key`.
# Leave ENABLE_PUBLIC_METRICS_ROUTE=false unless something genuinely needs
# unauthenticated scraping (GMS has had the same flag all along).
ENABLE_PUBLIC_METRICS_ROUTE=false
METRICS_API_KEY=

ADMIN_REQUIRE_MFA=false

# Platform licensing (docs/operations/PLATFORM-LICENSING.md). SSO's own licence is only enforced if the platform administrator has saved one
# for SSO under Admin > Licences; with none, this setting changes nothing. enforce (default) = read-only once the licence has expired and its
# grace period is over; warn = compute and show the state but never refuse anything; off = ignore licences entirely.
# Written here explicitly because production reads .env.production and nothing else. Emergency switch: LICENSE_ENFORCEMENT=warn, then restart.
LICENSE_ENFORCEMENT=enforce
# Per-application licensing (docs/operations/PLATFORM-LICENSING.md section 9). In production LICENSE_REQUIRED defaults to TRUE: a system with no verified
# licence is unusable, so install a licence BEFORE deploying. Leave LICENSE_REQUIRED unset (setting it false is logged as an alert at every start).
# Public RS256 JWKs that may sign licences (public key only; the owner generates the key pair at a trusted terminal and keeps the private key off every server).
LICENSE_TRUST_PUBLIC_KEYS=
# Optional: path to a dedicated licence-signing PEM on THIS server. Prefer signing offline (npm run license:sign) so the private key exists on no server.
# LICENSE_SIGNING_KEY_FILE=

# Tamper detection and incident response (SSO-OPERATIONS.md section 17).
# INCIDENT_LOCK_FILE: while this FILE exists every state-changing request answers 403 INCIDENT_READ_ONLY (sign-in, health, licence routes, the owner's verification and the key routes excepted).
#   Unset = no file lock (development). A deployment that uses incident containment points it at <data folder>\incident.lock. Only an operator at a terminal on the server clears a lock (SSO-OPERATIONS.md section 17).
# INCIDENT_RESPONSE: contain (record, alert, end the offender's sessions, lock) | alert (record and alert only) | off. Default: contain in production, alert elsewhere.
# OPS_WATCH_KEY_FILE: a file holding the shared key for the read-only chain-head endpoint the tamper watcher's daily anchor calls (set it when a watcher is used).
# INCIDENT_LOCK_FILE=
# INCIDENT_RESPONSE=contain
# OPS_WATCH_KEY_FILE=
# ── Owner verification (Phase 4; docs/sso/SSO-OPERATIONS.md, "Owner verification") ───────────────────────────────────────────
# Owner-only operations need a single-use owner authorisation (questions + emailed code or recovery code + phone authenticator). Production reads this file only,
# so write it here. Never set it to false on a live server (the release preflight refuses that). Not enrolled = those operations are refused.
OWNER_VERIFICATION_REQUIRED=true
# Whether a NEW enrolment (owner:enroll, owner:recover) includes the phone authenticator. Default false (owner decision 2026-10-21): a new enrolment has two proofs only:
# the security questions, then the emailed code (or one recovery code when email cannot be used). It decides only what a NEW enrolment asks for: the factors are recorded
# inside the sealed owner store and verification always demands those, so changing this line later never weakens an existing enrolment (re-enrol with owner:recover to change it).
# With false, anyone who knows the answers AND controls the owner's mailbox can act as the owner (SSO-OPERATIONS.md section 16, "Honest limits"). Write true to add the phone authenticator.
OWNER_AUTHENTICATOR_REQUIRED=false
# AES key file for the sealed owner store: a path OUTSIDE the repository, readable only by the account that runs SSO. Created by: npm run owner:enroll (production: node scripts/run-with-env.cjs production npx tsx scripts/owner-enroll.ts).
OWNER_STORE_KEY_FILE=
# Outgoing mail for the emailed code. If these are removed or changed the emailed code becomes unavailable and an offline recovery code replaces it; re-confirm with npm run owner:change-email.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# ── Platform settings (2026-10-11) ───────────────────────────────────────────────────────────────────────────────────────────
# LOGIN_LOCKOUT_ENABLED, ADMIN_REQUIRE_MFA and the TTL_* values above are now only the DEFAULTS. The platform administrator can change
# them (and password rules, branding, retention) under Admin > Settings; a stored change wins and applies without a restart.
# Reset a setting there to go back to the value in this file.
#
# How many password checks (scrypt, ~128 MB each) may run at once, how many may wait, and how long one may wait before it is turned away
# with "busy, try again". Worst-case memory is concurrency x 128 MB. Defaults shown; leave them unless the System page shows turned-away
# sign-ins during normal use.
# PASSWORD_HASH_CONCURRENCY=3
# PASSWORD_HASH_QUEUE=60
# PASSWORD_HASH_WAIT_MS=8000
# "Forgot your password?" requests (no email: they go to the administrators under Admin > Users). How many one address may send in a quarter hour.
# Leave at the default in production; the browser test suite raises it in development.
# RESET_REQUEST_RATE_LIMIT=5

# ── Other applications that sign in through this IdP (all optional; the Example Corp production and mirror leave every one of these unset) ───────────────────
# MOS (Manufacturing Operations Suite, on Odoo). MOS_ENABLED=true registers the OIDC client "mos"; then all three of these are REQUIRED (no fallback, so a production
# IdP can never boot with a development secret or a localhost address): MOS_CLIENT_SECRET, MOS_REDIRECT_URIS, MOS_LOGOUT_URIS (comma-separated addresses).
# MOS_PORTAL_URL puts a MOS tile on the portal (the address that starts MOS's own sign-in); without it MOS has no tile.
# MOS_BACKCHANNEL_LOGOUT_URI (optional) is where SSO POSTs a signed logout token when a person signs out or is disabled, so MOS ends that person's sessions too (server to server).
# MOS_ENABLED=false
# MOS_CLIENT_SECRET=
# MOS_REDIRECT_URIS=
# MOS_LOGOUT_URIS=
# MOS_PORTAL_URL=
# MOS_BACKCHANNEL_LOGOUT_URI=
# Any other application, as JSON lists (oidc/product-clients.ts; a malformed list stops the start):
#   PRODUCT_CLIENTS_JSON=[{"client_id":"shop","client_secret":"<16+ characters>","redirect_uris":["https://shop.example.com/auth/callback"],"post_logout_redirect_uris":["https://shop.example.com/"],"name":"Shop","backchannel_logout_uri":"http://127.0.0.1:16101/api/v1/auth/backchannel-logout"}]
#   PRODUCT_APPS_JSON=[{"rp":"shop","label":"Shop","name":"Shop - orders","url":"https://shop.example.com/"}]   (one portal tile per client; rp = the client_id)
# PRODUCT_CLIENTS_JSON=
# PRODUCT_APPS_JSON=
