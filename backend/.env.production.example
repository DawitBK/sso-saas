NODE_ENV=production
PORT=7300
IDP_ISSUER=https://portal.examplecorp.com/sso
IDP_INTERNAL_URL=http://127.0.0.1:7300
# Must be defined here — if it's ever missing/blank/commented out, the app
# refuses to boot on a stray ambient DATABASE_URL rather than silently
# connecting to it. Set DATABASE_URL_TRUSTED=1 to opt out.
DATABASE_URL=postgresql://postgres:12345678@127.0.0.1:5432/idpprod
TRUST_PROXY_HOPS=1

# Generate unique random values; never use the development defaults in production.
COOKIE_KEYS=replace-with-random-key-1,replace-with-random-key-2
TOTP_ENCRYPTION_KEY=replace-with-random-totp-key
IDP_AUDIT_HMAC_SECRET=replace-with-random-audit-key

# DMS (EDAMS): OIDC authorize + logout are URLs returned to the end user's
# browser — MUST use the public https://portal.examplecorp.com/dms origin.
# DMS_API_BASE_URL is called from the IdP backend itself on the same server,
# so 127.0.0.1 direct avoids a pointless reverse-proxy round-trip.
DMS_ENABLED=true
DMS_OIDC_AUTHORIZE_URL=https://portal.examplecorp.com/dms/api/v1/auth/oidc/authorize
DMS_BACKCHANNEL_LOGOUT_URI=https://portal.examplecorp.com/dms/api/v1/auth/backchannel-logout
DMS_API_BASE_URL=http://127.0.0.1:7100/api/v1
DMS_INTERNAL_API_KEY=must-match-DMS_INTERNAL_API_KEY
DMS_DEFAULT_TENANT=examplecorp

EDAMS_CLIENT_SECRET=replace-with-DMS-OIDC-client-secret
EDAMS_REDIRECT_URIS=https://portal.examplecorp.com/dms/auth/callback
EDAMS_LOGOUT_URIS=https://portal.examplecorp.com/dms/login
GMS_CLIENT_SECRET=replace-with-GMS-client-secret
GMS_REDIRECT_URIS=https://portal.examplecorp.com/sso/bridge/gms/callback
GMS_LOGOUT_URIS=https://portal.examplecorp.com/gms/login
MRS_CLIENT_SECRET=replace-with-MRS-client-secret
MRS_REDIRECT_URIS=https://portal.examplecorp.com/mrs/api/auth/sso/callback
MRS_LOGOUT_URIS=https://portal.examplecorp.com/mrs/login
# Where the portal's MRS tile sends the browser to start that exchange.
MRS_SSO_LOGIN_URL=https://portal.examplecorp.com/mrs/api/auth/sso/login
PORTAL_CLIENT_SECRET=replace-with-portal-client-secret

GMS_BRIDGE_ENABLED=true
GMS_INTERNAL_API_KEY=must-match-GMS-SSO_INTERNAL_API_KEY
GMS_FRONTEND_URL=https://portal.examplecorp.com/gms
GMS_API_BASE=https://portal.examplecorp.com/api/v1
SSO_ROLES_API_KEY=must-match-GMS-SSO_ROLES_API_KEY

# Same-origin gateway for the GMS SSO handoff (gateway/server.ts). nginx
# proxies ONLY the narrow /gms/__sso path here — GMS's own already-proven
# /gms and /api/v1 rules are untouched and keep serving everything else.
# GATEWAY_URL must NOT be left at the dev-only gms.localtest.me default —
# assertProdSafeDefaults() refuses to boot if it detects that in production.
GATEWAY_PORT=4200
GATEWAY_URL=https://portal.examplecorp.com/gms
GMS_FRONTEND_TARGET=http://127.0.0.1:7201
GMS_API_TARGET=http://127.0.0.1:7200
