<%- include('head', { title: 'Sign-ins', adminEmail }) %>
  <h1>Sign-in activity</h1>
  <p class="sub">Every sign-in attempt at the IdP (last 100). Repeated failures raise the alert below and on the dashboard.</p>

  <% if (alerts.length > 0) { %>
  <div class="card" style="border-color:#fecaca; background:#fef2f2;">
    <p style="margin:0 0 8px; font-weight:700; color:#b91c1c; font-size:13px;">⚠ Possible brute-force activity (≥5 failures in 15 min)</p>
    <% alerts.forEach(function(a){ %>
      <p class="sub" style="margin:0; color:#7f1d1d;"><a class="link" style="color:#7f1d1d;" href="/admin/users?q=<%= encodeURIComponent(a.email) %>"><strong><%= a.email %></strong></a> — <%= a.failures %> failed attempts</p>
    <% }); %>
  </div>
  <% } %>

  <div class="card">
    <% if (events.length === 0) { %><p class="muted">No sign-in attempts recorded yet.</p><% } else { %>
    <table>
      <thead><tr><th>When</th><th>Email</th><th>Result</th><th>IP</th></tr></thead>
      <tbody>
        <% events.forEach(function(e){ %>
        <tr>
          <td class="muted" style="white-space:nowrap;"><%= new Date(e.created_at).toLocaleString() %></td>
          <td><%= e.email %></td>
          <td>
            <% if (e.success) { %><span class="badge on">OK</span>
            <% } else { %><span class="badge off" style="background:#fee2e2; color:#b91c1c;"><%= e.reason || 'failed' %></span><% } %>
          </td>
          <td class="muted" style="font-size:12px;"><%= e.ip %></td>
        </tr>
        <% }); %>
      </tbody>
    </table>
    <% } %>
  </div>
<%- include('foot') %>
