<%- include('head', { title: 'Set a new password' }) %>
  <h2>Set a new password</h2>
  <p class="sub">Your password was reset by an administrator. Choose a new one to continue to <strong><%= clientName %></strong>.</p>
  <% if (error) { %><div class="error"><%= error %></div><% } %>
  <form method="post" action="/interaction/<%= uid %>/password" autocomplete="off">
    <input type="hidden" name="csrf" value="<%= csrf %>" />
    <label for="password">New password</label>
    <input id="password" name="password" type="password" required minlength="8" autofocus placeholder="At least 8 characters" />
    <label for="confirm">Confirm new password</label>
    <input id="confirm" name="confirm" type="password" required minlength="8" placeholder="••••••••" />
    <button type="submit">Set password &amp; continue</button>
  </form>
<%- include('foot') %>
