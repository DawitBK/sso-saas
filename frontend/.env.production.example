NEXT_PUBLIC_BASE_PATH=/sso
SSO_BACKEND_URL=http://127.0.0.1:7300
# Must match the backend's IDP_ISSUER origin exactly (see main .env.production).
NEXT_PUBLIC_APP_ORIGIN=https://portal.examplecorp.com
# Content-Security-Policy mode of the frontend (proxy.ts): enforce (default), report-only (browser logs violations, blocks nothing; for trying a change)
# or off (break-glass; removes only the CSP header). Read at run time, no rebuild needed.
# SSO_CSP=enforce
